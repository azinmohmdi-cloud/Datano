# Legacy JWT utilities only; product HTTP routes no longer accept or issue JWTs (BE-009).
# JWT Configuration
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh Token Configuration
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL is required for the serving app. Run alembic upgrade head before startup.
# Use a private password, URL-encoded when necessary; never commit the actual URL.
# DATABASE_URL=postgresql+psycopg://datano:change-me@127.0.0.1:55432/datano
# Dedicated integration database only; its name must start with datano_test.
# Export DATANO_TEST_DATABASE_URL in the shell, not this .env file; see README.

# Public registration only: attempts per peer IP in a fixed UTC window.
# All workers must share these values and the PostgreSQL database.
REGISTRATION_IP_LIMIT=5
REGISTRATION_WINDOW_SECONDS=600
# Byte limit applies to the entire JSON body, including chunked requests.
REGISTRATION_MAX_BODY_BYTES=8192

# Approved opaque-session defaults; idle <= absolute for each profile.
# These apply when issuing a new session, not to existing records.
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
REMEMBER_SESSION_IDLE_SECONDS=604800
REMEMBER_SESSION_ABSOLUTE_SECONDS=2592000

# Explicit HTTP-only local development exception (localhost/loopback URL only).
# Uses datano_session_dev, never a __Host- cookie. Leave false for HTTPS/deployment.
SESSION_ALLOW_INSECURE_LOCAL_HTTP=false

# Login quota uses an independent namespace in the existing PostgreSQL counters.
LOGIN_IP_LIMIT=10
LOGIN_WINDOW_SECONDS=600
LOGIN_MAX_BODY_BYTES=8192

# Required browser boundary. Use the exact browser origin, without a trailing slash.
# Deployment uses the same HTTPS origin for the browser and /api.
# PUBLIC_ORIGIN=https://datano.example
# Required independent random secret, at least 32 UTF-8 bytes, shared by all workers.
# Generate privately with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# CSRF_SECRET_KEY=YOUR_PRIVATE_RANDOM_SECRET
# Explicit local HTTP example: PUBLIC_ORIGIN=http://localhost:3000 together with
# SESSION_ALLOW_INSECURE_LOCAL_HTTP=true; never enable this exception in deployment.

# BE-011 outbound SMTP. Disabled until valid private provider settings are supplied.
# No provider, credentials, sender or recipient is provisioned by this template.
SMTP_ENABLED=false
SMTP_SECURITY=starttls
SMTP_PORT=587
SMTP_TIMEOUT_SECONDS=10
# Set privately; all four are required when SMTP_ENABLED=true.
# SMTP_HOST=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# For implicit TLS, set SMTP_SECURITY=tls and the provider's port (usually 465).
# Optional private CA bundle; certificate/hostname verification always stays enabled.
# SMTP_CA_FILE=

# BE-012: provision separately and privately before enabling an email-code flow.
# At least 32 random private bytes; never reuse SMTP, CSRF or JWT credentials.
# EMAIL_CODE_HMAC_KEY=

# BE-013: recovery-only peer quota shared by request/verify/reset.
RECOVERY_IP_LIMIT=10
RECOVERY_WINDOW_SECONDS=600
RECOVERY_MAX_BODY_BYTES=8192
# Restricted reset-only authorization, never a product login session (max 600).
RECOVERY_GRANT_SECONDS=600

# BE-014: private server eligibility only; an address never grants authority.
# JSON array, trim/lowercase only, no Gmail alias normalization. No default admin.
# Store actual addresses only in a private ignored backend environment file.
ADMIN_EMAIL_ALLOWLIST=[]
# Independent technical peer bucket shared by admin-email request/verify.
ADMIN_PROOF_IP_LIMIT=10
ADMIN_PROOF_WINDOW_SECONDS=600
ADMIN_PROOF_MAX_BODY_BYTES=8192
